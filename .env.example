# ---------------------------------------------------------------------------
# Precious Metals Intelligence — environment configuration (template)
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Runtime environment ---
NODE_ENV=development
LOG_LEVEL=info

# --- Ports (host mappings) ---
# NOTE: web is 3100 (not 3000) because the user's Research Platform dev server
# uses 3000. API 8000 / quant 8001 / postgres 5432 / redis 6379 follow the spec.
WEB_PORT=3100
API_PORT=8000
QUANT_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- PostgreSQL (TimescaleDB) ---
POSTGRES_USER=pmi
POSTGRES_PASSWORD=change_me_in_real_env
POSTGRES_DB=pmi
DATABASE_URL=postgresql://pmi:change_me_in_real_env@postgres:5432/pmi
# Host-mapped URL for tools running on the host (alembic, psql):
DATABASE_URL_HOST=postgresql://pmi:change_me_in_real_env@localhost:5432/pmi

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_URL_HOST=redis://localhost:6379/0

# --- Market data providers (Phase 1+) ---
# https://twelvedata.com/docs — get a free/plan API key
TWELVEDATA_API_KEY=
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Economic calendar provider key (Phase 5) — adapter TBD
ECONOMIC_CALENDAR_API_KEY=
# News provider key (Phase 5) — adapter TBD
NEWS_API_KEY=

# --- LLM (Phase 7, LangGraph AI analyst) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- Telegram alerts (Phase 8) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Internal service URLs (container network) ---
API_INTERNAL_URL=http://api:8000
QUANT_INTERNAL_URL=http://quant:8001
